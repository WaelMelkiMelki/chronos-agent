# ─── App ─────────────────────────────────────────
APP_NAME=chronos-agent
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-64-char-hex-string-generated-above
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000


# ─── Postgres ────────────────────────────────────
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos_dev_password
POSTGRES_DB=chronos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chronos:chronos_dev_password@postgres:5432/chronos


# ─── Ports ───────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434
QDRANT_PORT=6333
NEXT_PUBLIC_API_URL=http://localhost:8000


# ─── JWT ─────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ─── Chiffrement des tokens OAuth ────────────────
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me


# ─── Google Calendar OAuth ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar


# ─── LLM Provider ────────────────────────────────
# Valeurs : ollama | groq | gemini | openai-compatible
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b


OLLAMA_BASE_URL=http://ollama:11434


GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# ─── Feature flags (V2) ──────────────────────────
FEATURE_QDRANT=false
FEATURE_MCP=false
QDRANT_URL=http://qdrant:6333
